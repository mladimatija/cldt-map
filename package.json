{
	"name": "cldt-map",
	"version": "1.9.0",
	"private": true,
	"license": "MIT",
	"author": "Matija Culjak (https://matijaculjak.com)",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev",
		"prebuild": "node scripts/stamp-sw-version.mjs && node scripts/split-pois.mjs",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check:i18n": "node scripts/check-i18n-parity.mjs",
		"check:bundle": "node scripts/check-bundle-size.mjs",
		"generate-pwa-icons": "node scripts/generate-pwa-icons.mjs",
		"build:emergency-data": "tsx scripts/build-emergency-data.ts",
		"update-mine-areas": "tsx --env-file-if-exists=.env.local scripts/update-mine-areas.ts",
		"update-seasonal": "tsx --env-file-if-exists=.env.local scripts/update-seasonal-status.ts",
		"enrich-osm": "tsx --env-file-if-exists=.env.local scripts/enrich-trail-osm.ts",
		"enrich-junctions": "tsx --env-file-if-exists=.env.local scripts/enrich-trail-junctions.ts",
		"enrich-pois": "tsx --env-file-if-exists=.env.local scripts/enrich-pois.ts && node scripts/split-pois.mjs",
		"clean-install": "rm -rf node_modules .next package-lock.json && npm install"
	},
	"dependencies": {
		"@garmin/fitsdk": "^21.218.0",
		"@netlify/blobs": "^11.1.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"docx": "^9.13.0",
		"fflate": "^0.8.3",
		"html-to-image": "^1.11.13",
		"jspdf": "^4.2.1",
		"leaflet": "^1.9.4",
		"leaflet-boundary-canvas": "^1.0.0",
		"localforage": "^1.10.0",
		"next": "16.4.2",
		"next-intl": "^4.14.9",
		"open-location-code": "^1.0.3",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-icons": "^5.7.0",
		"react-leaflet": "^5.0.0",
		"react-qr-code": "^2.2.0",
		"react-select": "^5.10.2",
		"recharts": "^3.10.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss-animate": "^1.0.7",
		"web-push": "^3.6.7",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^1.1.0",
		"@eslint/eslintrc": "^3.3.7",
		"@netlify/functions": "^6.0.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/leaflet": "^1.9.22",
		"@types/leaflet-boundary-canvas": "^1.0.4",
		"@types/node": "^26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/web-push": "^3.6.4",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"eslint": "^10.13.0",
		"eslint-config-next": "16.4.2",
		"eslint-config-prettier": "^10.1.8",
		"jiti": "^2.7.0",
		"postcss": "^8.5.31",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0"
	}
}
