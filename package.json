{
	"name": "cldt-map",
	"version": "1.8.0",
	"private": true,
	"license": "MIT",
	"author": "Matija Culjak (https://matijaculjak.com)",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev",
		"prebuild": "node scripts/stamp-sw-version.mjs && node scripts/split-pois.mjs && npm run format",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check:i18n": "node scripts/check-i18n-parity.mjs",
		"check:bundle": "node scripts/check-bundle-size.mjs",
		"generate-pwa-icons": "node scripts/generate-pwa-icons.mjs",
		"build:emergency-data": "tsx scripts/build-emergency-data.ts",
		"update-mine-areas": "tsx --env-file-if-exists=.env.local scripts/update-mine-areas.ts",
		"update-seasonal": "tsx --env-file-if-exists=.env.local scripts/update-seasonal-status.ts",
		"enrich-osm": "tsx --env-file-if-exists=.env.local scripts/enrich-trail-osm.ts",
		"enrich-pois": "tsx --env-file-if-exists=.env.local scripts/enrich-pois.ts && node scripts/split-pois.mjs",
		"clean-install": "rm -rf node_modules .next package-lock.json && npm install"
	},
	"dependencies": {
		"@garmin/fitsdk": "^21.208.0",
		"@netlify/blobs": "^10.7.9",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"docx": "^9.7.1",
		"fflate": "^0.8.3",
		"html-to-image": "^1.11.13",
		"jspdf": "^4.2.1",
		"leaflet": "^1.9.4",
		"leaflet-boundary-canvas": "^1.0.0",
		"localforage": "^1.10.0",
		"next": "16.2.9",
		"next-intl": "^4.13.0",
		"open-location-code": "^1.0.3",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-icons": "^5.6.0",
		"react-leaflet": "^5.0.0",
		"react-qr-code": "^2.2.0",
		"react-select": "^5.10.2",
		"recharts": "^3.8.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7",
		"web-push": "^3.6.7",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.105.0",
		"@eslint/eslintrc": "^3.3.5",
		"@netlify/functions": "^5.3.0",
		"@tailwindcss/postcss": "^4.3.1",
		"@types/leaflet": "^1.9.21",
		"@types/leaflet-boundary-canvas": "^1.0.4",
		"@types/node": "^26.0.0",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/web-push": "^3.6.4",
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"eslint": "^10.5.0",
		"eslint-config-next": "16.2.9",
		"eslint-config-prettier": "^10.1.8",
		"jiti": "^2.7.0",
		"postcss": "^8.5.14",
		"prettier": "^3.8.4",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sharp": "^0.35.2",
		"tailwindcss": "^4.3.1",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3"
	}
}
