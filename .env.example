# GPX data source (required)
NEXT_PUBLIC_GPX_URL=https://cldt.hr/wp-content/uploads/2023/11/CLDT_Croatian_Long_Distance_Trail_2023_v1.gpx

# Cache version - bump to invalidate cached GPX
NEXT_PUBLIC_CACHE_VERSION=1

# Optional: GPX fetch proxy (default /api/proxy?url=)
# NEXT_PUBLIC_CORS_PROXY=/api/proxy?url=

# Optional: override defaults (change without committing)
# NEXT_PUBLIC_DEFAULT_DIRECTION=SOBO
# NEXT_PUBLIC_DEFAULT_UNITS=metric
# NEXT_PUBLIC_DEFAULT_DISTANCE_PRECISION=2
# NEXT_PUBLIC_SHOW_BOUNDARY=false
# NEXT_PUBLIC_SHOW_TILE_BOUNDARY=false
# NEXT_PUBLIC_SHOW_USER_MARKER=true
# NEXT_PUBLIC_DEFAULT_BASE_MAP=OpenStreetMap
# NEXT_PUBLIC_DEFAULT_DARK_MODE=false
# NEXT_PUBLIC_DEFAULT_BATTERY_SAVER=false
# NEXT_PUBLIC_DEFAULT_LARGE_TOUCH_TARGETS=false
# NEXT_PUBLIC_DEFAULT_RULER_ENABLED=false
# NEXT_PUBLIC_DEFAULT_SHOW_SECTIONS=false
# NEXT_PUBLIC_DEFAULT_GRADE_TINTED_TRAIL=false
# NEXT_PUBLIC_DEFAULT_SURFACE_COLOURED=false  # requires populated public/trail-osm-tags.json (npm run enrich-osm)
# NEXT_PUBLIC_DEFAULT_SAC_COLOURED=false      # requires populated public/trail-osm-tags.json (npm run enrich-osm)
# NEXT_PUBLIC_DEFAULT_DISTANCE_MARKERS=false  # zoom-aware km/mi markers along the trail (set true to ship enabled)
# NEXT_PUBLIC_DEFAULT_POIS_ENABLED=true        # POI map layer master toggle
# NEXT_PUBLIC_DEFAULT_POI_TYPES=town,settlement,peak,viewpoint,hut,shelter,restaurant,cafe,food,atm # comma-separated types enabled by default (known types: town,settlement,peak,viewpoint,hut,shelter,restaurant,cafe,food,atm)
# NEXT_PUBLIC_DEFAULT_WALKING_PACE_KMH=4
# NEXT_PUBLIC_DEFAULT_GRADE_ADJUSTED_ETA=true
# NEXT_PUBLIC_DEFAULT_SUNSET_PROJECTION=false
# NEXT_PUBLIC_DEFAULT_SEVERE_WEATHER_LAYER=false
# NEXT_PUBLIC_DEFAULT_SHARE_SHORT_LINKS=true   # compact /s/{code} links when sharing (Netlify only; npm run dev uses long URLs)
#
# Netlify-built-in (do NOT add locally): URL, DEPLOY_URL, DEPLOY_PRIME_URL are read-only deploy
# URLs set automatically on Netlify and by `netlify dev`. Used by the share shortener host allowlist.
# See README "Share link shortener" -> "Netlify-built-in deploy URLs".
# Optional (Netlify Site settings only): extra share-link hostnames, comma-separated.
# SHARE_EXTRA_ALLOWED_HOSTS=www.map.cldt.hr
# NEXT_PUBLIC_DEFAULT_SEASONAL_STATUS_ENABLED=  # leave blank to use winter-window auto (Nov-May); set true/false to override
# NEXT_PUBLIC_DEFAULT_AUTO_SYNC=false
# NEXT_PUBLIC_DEFAULT_PREDICTIVE_PRECACHE=false
# NEXT_PUBLIC_DEFAULT_LOCALE=en
# NEXT_PUBLIC_DEFAULT_MAP_CENTER=44.4268,16.438
# NEXT_PUBLIC_DEFAULT_MAP_ZOOM=7
# NEXT_PUBLIC_TILE_CACHE_TTL_DAYS=30

# Optional: remote data sources (fall back to bundled JSON on network error)
# NEXT_PUBLIC_NOTICES_URL=https://example.com/notices.json
# NEXT_PUBLIC_SEASONAL_STATUS_URL=https://example.com/seasonal-status.json
# NEXT_PUBLIC_TRAIL_OSM_TAGS_URL=https://example.com/trail-osm-tags.json
# NEXT_PUBLIC_POIS_URL=https://example.com/pois.json

# Required by `npm run update-seasonal` (curator). When also set in the deploy
# environment, enables the /api/narrative route (AI day narratives for trip
# briefs); the brief falls back to templated text when unset.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override for /api/narrative.
# NARRATIVE_MODEL=claude-sonnet-4-6

# Script-only: optional Overpass endpoint override for `npm run enrich-osm`
# and `npm run enrich-pois`.
# Defaults to https://overpass-api.de/api/interpreter when unset.
# OSM_OVERPASS_URL=https://overpass.kumi.systems/api/interpreter

# Script-only: comma-separated Overpass mirrors that `npm run enrich-pois`
# fails over to after the primary endpoint exhausts its retries. Defaults to
# https://overpass.kumi.systems/api/interpreter; set empty to disable failover.
# OSM_OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter

# Script-only: per-type Overpass results from `npm run enrich-pois` are cached
# in .cache/enrich-pois so a rerun after a partial failure only refetches the
# types that failed. Optional knobs:
# ENRICH_POIS_CACHE_TTL_HOURS=24
# ENRICH_POIS_NO_CACHE=1

# Script-only: checkpoint merged POI state after each enrich-pois pass in
# .cache/enrich-checkpoints/ so a failed run can resume without re-querying
# earlier passes. Examples:
#   ENRICH_FROM_PASS=6 npm run enrich-pois   # resume at Pass 6 (reachability)
#   npm run enrich-pois -- --resume          # continue from latest checkpoint
# ENRICH_CLEAR_CHECKPOINTS=1 deletes checkpoints after a successful write.
# ENRICH_NO_CHECKPOINTS=1 disables checkpoint writes.

# Deploy-only (optional): browser push when new seasonal warnings or trail condition
# notices are published. Users opt in via Settings ("Notify about trail alerts");
# VAPID is deployer infrastructure, not user-facing. Without all three vars below,
# the toggle stays hidden and in-app banners still work.
#
# Generate a key pair:
#   npx web-push generate-vapid-keys
#
# Set all three in Netlify: Site configuration -> Environment variables ->
# Production (redeploy required after changing NEXT_PUBLIC_*). Optional locally
# in .env.local for `netlify dev` (not plain npm run dev).
#
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # public key; baked into client at build time
# VAPID_PRIVATE_KEY=              # secret; server-only, never commit
# VAPID_SUBJECT=mailto:you@example.com
#   Contact URI for push services (mailto: or https:// URL). Not shown to users;
#   not a secret. Required by the Web Push protocol alongside the key pair.
#
# Hourly Netlify Functions (no extra env): push-seasonal-check (seasonal-status.json),
# push-notices-check (notices feed). See README "Web push notifications (VAPID)".
